.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Benchmark-managed JavaScript toolchain payloads; manifests and lockfiles remain tracked.
toolchains/*/*/node_modules/
# The pinned Node executable is a local benchmark-toolchain payload; its identity is tracked.
toolchains/node/*/bin/node
# OpenCode is likewise a locally provisioned benchmark-toolchain payload.
toolchains/opencode/*/bin/opencode
# Hermes and its CPython runtime are locally materialized benchmark-toolchain
# payloads. Their exact identities are tracked, but the payloads are not.
toolchains/hermes/*/source/
toolchains/hermes/*/venv/
toolchains/python/*/

runs/
artifacts/
.bench/

*.log
.DS_Store
